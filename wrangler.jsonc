{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xui",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-15",
  "workers_dev": true,
  "vars": {
    "ADMIN_USERNAME": "admin",
    "ADMIN_PASSWORD": "",
    // 住宅代理凭据（可选）：留空 = 住宅代理关闭（零轮询零额度消耗，推荐）
    // 启用方法：部署后在 Dashboard → Settings → Variables and Secrets 添加
    //   PROXY_USER=你的用户名  PROXY_PASS=你的密码  （用 Secret 类型，改完重新部署）
    // ⚠️ 注意：这里不要填非空默认值——vars 里非空值会被当作"已配置"从而启用
    //    住宅代理轮询，若没有真实住宅出口账号会持续产生请求烧掉免费额度。
    "PROXY_USER": "",
    "PROXY_PASS": "",
    "TG_WEBHOOK_SECRET": ""
  },
  "assets": {
    "directory": "static",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*", "/health", "/agent/ws", "/dashboard/*", "/public/*", "/notify", "/public-policy", "/frequency-policy"]
  },
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "VPS_PRESENCE", "class_name": "VpsPresence" },
      { "name": "DASHBOARD_HUB", "class_name": "DashboardHub" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["VpsPresence", "DashboardHub"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
